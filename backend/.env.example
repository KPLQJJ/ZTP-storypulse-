# StoryPulse Backend 环境变量

# JWT 密钥（必填 — 生产环境须设为 64+ 字符随机字符串）
JWT_SECRET_KEY=generate-a-random-string-at-least-64-characters-long

# 数据库 (默认 SQLite，生产改为 PostgreSQL)
# DATABASE_URL=sqlite:///./storypulse.db

# AI 审稿 API（DeepSeek 兼容）
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 调试模式 (默认 false)
# DEBUG=false
